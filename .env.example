# OpenAI Configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Database Configuration (PostgreSQL with TimescaleDB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=offer_agent
POSTGRES_USER=offer_agent
POSTGRES_PASSWORD=secure_password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=offer_requirements

# Application Settings
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
API_VERSION=v1
ENVIRONMENT=development

# Security & JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
API_KEY_SALT=your_api_key_salt

# Rate Limiting
API_RATE_LIMIT=100
API_RATE_WINDOW_MINUTES=1

# GDPR & Data Retention
DATA_RETENTION_YEARS=10
DELETION_GRACE_PERIOD_YEARS=4
ENCRYPTION_KEY=your_encryption_key_base64

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=AI Offer Agent

# Keycloak Authentication
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=offer-agent
KEYCLOAK_CLIENT_ID=offer-agent-api
KEYCLOAK_CLIENT_SECRET=your_client_secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
KEYCLOAK_DB=keycloak

# Monitoring & Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_TRACING=true

# Performance Tuning
MAX_CONCURRENT_GENERATIONS=5
OFFER_GENERATION_TIMEOUT_SECONDS=30
CONVERSATION_CONTEXT_MAX_SIZE=10000

# Feature Flags
ENABLE_COCOMO_ESTIMATION=true
ENABLE_APPROVAL_WORKFLOW=true
ENABLE_MULTI_LANGUAGE=true
ENABLE_VECTOR_SEARCH=true

# Microservices Ports
CONVERSATION_SERVICE_PORT=8001
OFFER_SERVICE_PORT=8002
CUSTOMER_SERVICE_PORT=8003
ESTIMATION_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8005
GATEWAY_PORT=8000

# COCOMO Model Configuration
COCOMO_MODE=intermediate
COCOMO_CONFIDENCE_THRESHOLD=0.75
COCOMO_UPDATE_FREQUENCY_DAYS=30

# PDF Generation
PDF_TEMPLATE_DIR=./templates/pdf
PDF_OUTPUT_DIR=./generated/pdfs
DIN5008_COMPLIANCE=true

# Circuit Breaker Settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Kong API Gateway Configuration
KONG_POSTGRES_DB=kong
KONG_POSTGRES_USER=kong
KONG_POSTGRES_PASSWORD=kong_password
KONG_DB_PORT=5433
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443
KONG_ADMIN_PORT=8001
KONG_ADMIN_GUI_PORT=8002

# Kong API Keys
A2A_API_KEY=a2a-test-key-change-in-production
FRONTEND_API_KEY=frontend-test-key-change-in-production
MONITORING_API_KEY=monitoring-test-key-change-in-production

# Security Settings
ENFORCE_HTTPS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
